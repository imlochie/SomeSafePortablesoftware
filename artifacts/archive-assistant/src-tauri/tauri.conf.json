{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ARCHIVE ASSISTANT",
  "version": "0.1.0",
  "identifier": "com.imlochie.archiveassistant",
  "build": {
    "beforeDevCommand": "pnpm --dir ../.. --filter @workspace/api-server run build && pnpm --dir ../.. --filter @workspace/archive-assistant run dev",
    "devUrl": "http://127.0.0.1:3000",
    "beforeBuildCommand": "node ./scripts/stage-node-runtime.mjs && node ./scripts/stage-media-tools.mjs && pnpm --dir ../.. --filter @workspace/api-server run build && pnpm --dir ../.. --filter @workspace/archive-assistant run build",
    "frontendDist": "../dist/public"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg1REI0MEU1NzRENkMwRDUKUldUVndOWjA1VURiaGVvVmFuTFFxemJqQVlvZW1wKzRUdUIwVHhpVCt6OUZlVkNwdHQ2Mmh6ckw=",
      "endpoints": [
        "https://github.com/imlochie/SomeSafePortablesoftware/releases/latest/download/latest.json"
      ]
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ARCHIVE ASSISTANT",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "visible": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png"],
    "resources": {
      "../../api-server/dist/": "api-server/dist/",
      "runtime/": "runtime/"
    }
  }
}