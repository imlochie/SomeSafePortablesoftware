modules = ["nodejs-24", "python-base-3.13", "rust-stable"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["pkg-config", "glib", "gtk3", "webkitgtk_4_1", "libsoup_3", "librsvg", "pango", "cairo", "gdk-pixbuf", "openssl", "xorg.libX11", "xorg.libXcursor", "xorg.libXi", "xorg.libXrandr", "xorg.libxcb", "libxkbcommon", "zlib"]
